<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>CivOne.SDL</AssemblyName>
		<RootNamespace>CivOne</RootNamespace>
		<OutputType>Exe</OutputType>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>13.0</LangVersion>
		<RuntimeIdentifiers>win-x86;win-x64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<DefineConstants>DEBUG</DefineConstants>
		<OutputPath>bin/Debug</OutputPath>
		<Optimize>false</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.StartsWith('Preview')) OR $(Configuration.StartsWith('Release'))">
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.StartsWith('Preview'))">
		<DefineConstants>PREVIEW</DefineConstants>
		<OutputPath>bin/Preview</OutputPath>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
		<DefineConstants>RELEASE</DefineConstants>
		<OutputPath>bin/Release</OutputPath>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.EndsWith('Windows'))">
		<!-- A GUI exe, so no console window opens behind the game; help text then prints nowhere. -->
		<OutputType>WinExe</OutputType>
		<ApplicationIcon>../../resources/windows/CivOne.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('Embedded'))">
		<TargetFramework>netstandard2.0</TargetFramework>
		<OutputType>Library</OutputType>
		<DefineConstants>$(DefineConstants);EMBEDDED</DefineConstants>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants Condition="$(Configuration.EndsWith('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
		<DefineConstants Condition="$(Configuration.EndsWith('Linux'))">$(DefineConstants);LINUX</DefineConstants>
		<DefineConstants Condition="$(Configuration.EndsWith('MacOS'))">$(DefineConstants);MACOS</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../../CivOne.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="**" />
		<Compile Include="src/**" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Resources/**" />
		<!-- The Earth maps live outside Resources/ (resources/, Map.ResolveEarthBin), so they are
		     embedded by hand. Embedded so the runtime installs them for a packaged build;
		     tools/check_shipped_data.sh refuses a package without them, or without the tiles. -->
		<EmbeddedResource Include="../../resources/earth_epic.bin;../../resources/earth_standard.bin">
			<LogicalName>CivOne.Resources.defaults.data.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
</Project>